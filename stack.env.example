# Copy to stack.env (git-ignored), or enter these as environment variables in the Portainer stack.

# Everything here is optional: Kasboek runs without any of it.

# Starting login. Without these, a fresh Kasboek starts with kasboek / kasboek and asks you to choose your own
# login after the first sign-in. Either way you change it later in the app (person icon, top right).
# KASBOEK_USER=
# KASBOEK_PASSWORD=
# KASBOEK_AUTH=off            # local development only: no login at all

# Docker Compose only: where the data lives (absolute path) and which port to use.
# KASBOEK_DATA=/srv/kasboek/data
# KASBOEK_PORT=8420

# Enable Banking: upload the <application-id>.pem key on the Banks page. Override only if needed:
# EB_APP_ID=
# EB_KEY_PATH=/data/<application-id>.pem
# EB_REDIRECT_URL=https://kasboek.example.nl/banks/callback   # can also be set on the Banks page
# SYNC_HOURS=6                                               # background sync interval (PSD2: max ~4/day)

# Local AI for unsure categories (Ollama on the AI box, never a cloud URL). Can also be set on the queue page.
# LLM_BASE_URL=http://aibox:11434/v1
# LLM_MODEL=qwen2.5:7b

# Later milestones:
# NTFY_TOPIC=
