# Copy to stack.env (git-ignored), or enter these as environment variables in the Portainer stack.

# Household login (one shared account). Without a password Kasboek is open to anyone who can reach it.
KASBOEK_USER=kasboek
KASBOEK_PASSWORD=

# Enable Banking: put <application-id>.pem in /data and Kasboek finds it. Override only if needed:
# EB_APP_ID=
# EB_KEY_PATH=/data/<application-id>.pem
# EB_REDIRECT_URL=https://kasboek.example.nl/banks/callback   # can also be set on the Banks page
# SYNC_HOURS=6                                               # background sync interval (PSD2: max ~4/day)

# Local AI for unsure categories (Ollama on the AI box, never a cloud URL). Can also be set on the queue page.
# LLM_BASE_URL=http://aibox:11434/v1
# LLM_MODEL=qwen2.5:7b

# Later milestones:
# NTFY_TOPIC=
